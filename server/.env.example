# ── Razorpay test-mode credentials ───────────────────────────────
# Dashboard -> Settings -> API Keys. Test mode only: rzp_test_...
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks. This signs every delivery.
RAZORPAY_WEBHOOK_SECRET=

# ── Safety ───────────────────────────────────────────────────────
# Nothing leaves this machine unless this is exactly "true".
RAZORPAY_LIVE=false

# Salt for one-way contact hashing. Raw phone numbers and emails
# never enter the ledger. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_SALT=

PORT=8787
DATA_DIR=./data

# ── Optional: LLM policy arm (npm run recover:llm) ────────────────
# Free, no card required: https://console.groq.com/keys
# Free-tier limits (checked against Groq's docs, not assumed):
# 30 requests/minute, 6,000 tokens/minute, 14,400 requests/day.
GROQ_API_KEY=

# Verified current as of this build — check console.groq.com/docs/deprecations
# before relying on this if it's been a while; Groq retires models on a
# real schedule and llama-3.1-8b-instant (the obvious "small model" choice)
# was already shut down by the time this file was written.
GROQ_MODEL=openai/gpt-oss-20b
